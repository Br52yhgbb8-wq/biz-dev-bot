# ── UNIEPU + Mercury 生产环境配置 ──
# 将此文件内容填入 /opt/uniepu/backend/.env
# 或部署时通过环境变量注入

# ── 安全（必须修改） ──
SECRET_KEY=<生成一个 64 位随机 hex>
INVITE_CODE=<邀请码，留空则注册开放>

# ── DeepSeek LLM（Hermes AI Agent） ──
DEEPSEEK_API_KEY=sk-你的Key
LLM_ENABLED=true

# ── Hermes 安全 ──
HERMES_ALLOWED_ORIGINS=https://你的域名.com,https://www.你的域名.com
HERMES_DAILY_TOKEN_BUDGET=1000000
HERMES_RATE_LIMIT_PER_IP=30

# ── 环境 ──
DEV_MODE=false
DEBUG=false
