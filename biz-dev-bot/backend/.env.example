# ── Required ──
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY="change-me-to-a-random-value"

# ── Database ──
# Production (PostgreSQL):
# DATABASE_URL="postgresql+asyncpg://bizdev:<password>@localhost:5432/bizdev"
# Dev (SQLite, no Docker needed):
DEV_MODE=true
# DATABASE_URL="sqlite+aiosqlite:///./dev.db"

# ── Security ──
# Set an invite code to restrict registration (leave empty to allow open registration)
INVITE_CODE=""
# Disable Swagger docs in production
DISABLE_DOCS=false
# Rate limit: number of login attempts per time window
RATE_LIMIT_LOGIN="5/minute"

# ── Optional overrides ──
# ACCESS_TOKEN_EXPIRE_MINUTES=120
# DEBUG=false
# MAX_UPLOAD_SIZE_MB=10

# ── Monitoring ──
# Sentry DSN for error tracking (optional, leave empty to disable)
SENTRY_DSN=""

# ── Gemini Lead Gen ──
# Get API key: https://aistudio.google.com/apikey
# GEMINI_API_KEY="your-api-key"
# GEMINI_MODEL="gemini-2.0-flash"
# LEAD_GEN_ENABLED=true
# LEAD_SCORE_THRESHOLD=60
