              },
              {
                icon: Mail,
                title: "Gmail 集成",
                desc: "收发邮件、自动同步收件箱、将邮件关联到联系人记录。",
              },
              {
                icon: Linkedin,
                title: "LinkedIn 获客",
                desc: "搜索潜在客户、提取资料、批量导入 CRM，自动化社交获客。",
              },
              {
                icon: SendHorizontal,
                title: "营销活动",
                desc: "创建多步骤触达序列，定时跟进，用数据驱动转化。",
              },
            ].map((feature) => {
