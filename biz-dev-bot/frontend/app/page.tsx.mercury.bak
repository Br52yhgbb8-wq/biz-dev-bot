                    style={{ backgroundColor: "#F0F0F2" }}
                  >
                    <Icon className="w-5 h-5" style={{ color: accent }} />
                  </div>
                  <h3 className="text-lg font-semibold text-[#1d1d1f] mb-2">{feature.title}</h3>
                  <p className="text-sm leading-relaxed" style={{ color: "#86868B" }}>{feature.desc}</p>
                </div>
              )
            })}
          </div>
        </div>
      </section>


      {/* ── Footer ── */}
      <footer className="py-8 border-t" style={{ borderColor: "#F0F0F2" }}>
        <div className="max-w-[1280px] mx-auto px-6 lg:px-12 flex items-center justify-between">
          <div className="flex items-center">
            <img src="/images/logo.svg" alt="Mercury" className="h-5 w-auto opacity-40" />
          </div>
          <p className="text-sm" style={{ color: "#C7C7CC" }}>© 2026 Mercury</p>
