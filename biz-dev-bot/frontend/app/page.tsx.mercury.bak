      {/* ── Navigation (unchanged) ── */}
      <nav className="fixed top-0 left-0 right-0 z-50 h-16 bg-white/80 backdrop-blur-md border-b border-[#f2f2f7]">
        <div className="max-w-[1280px] mx-auto px-6 lg:px-12 h-full flex items-center justify-between">
          <div className="flex items-center">
            <img src="/images/logo.svg" alt="Mercury" className="h-8 w-auto" />
          </div>
          <div className="flex items-center gap-6">
            <button
              onClick={scrollToFeatures}
              className="text-sm text-[#86868b] hover:text-[#1d1d1f] transition-colors bg-transparent border-none cursor-pointer"
            >
              功能
            </button>
            <Button variant="ghost" onClick={() => router.push("/login")}>
              登录
            </Button>
          </div>
        </div>
      </nav>

      {/* ── Hero ── */}
      <section className="relative min-h-screen flex items-center justify-center pt-16 overflow-hidden">
        {/* Background video — centered, full-bleed */}
        <div className="absolute inset-0 flex items-center justify-center">
          <video
            autoPlay
            muted
            playsInline
            className="w-full h-full object-cover"
          >
            <source src="/images/hero-bg.mp4" type="video/mp4" />
          </video>
        </div>

        {/* Very subtle overlay to keep text readable */}
        <div className="absolute inset-0 bg-white/20" />

        {/* Centered content */}
        <div className="relative z-10 text-center max-w-[600px] px-6 py-20 lg:py-32">
          <div className="mb-5 opacity-0 animate-fade-in-up">
            <span
              className="inline-flex items-center h-6 px-3 text-[11px] font-medium tracking-[0.5px] uppercase rounded-full"
              style={{ backgroundColor: "#F0F0F2", color: accent }}
