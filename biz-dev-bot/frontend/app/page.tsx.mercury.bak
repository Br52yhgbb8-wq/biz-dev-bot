            >
              了解更多
            </button>
          </div>
        </div>
      </section>

      {/* ── Features ── */}
      <section id="features" className="py-24 lg:py-32" style={{ backgroundColor: "#F8F8FA" }}>
        <div className="max-w-[1280px] mx-auto px-6 lg:px-12">
          <div className="text-center mb-16">
            <h2 className="text-[32px] lg:text-[36px] font-bold text-[#1d1d1f] tracking-[-0.5px] mb-4">
