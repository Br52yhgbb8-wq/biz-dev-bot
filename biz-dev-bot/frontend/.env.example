# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# In production, replace with your deployed API URL:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Build-time overrides (Next.js embeds these at build time, not runtime)
# To use different backends per environment, set these in your CI/CD or
# deployment platform environment variables before running `pnpm build`.

# Monitoring
# NEXT_PUBLIC_SENTRY_DSN=""
