# ═══════════════════════════════════════════════════
#  UNIEPU + Mercury — Docker 生产环境配置
#  复制为 .env 并修改后运行: docker compose up -d
# ═══════════════════════════════════════════════════

# ── 必需 ──
SECRET_KEY=<运行 openssl rand -hex 32 生成>
DEEPSEEK_API_KEY=sk-你的DeepSeekKey

# ── 数据库 ──
DB_PASSWORD=bizdev          # 可改
POSTGRES_USER=bizdev        # 可改

# ── Hermes AI Agent ──
LLM_ENABLED=true
HERMES_ALLOWED_ORIGINS=https://你的域名.com,https://www.你的域名.com
HERMES_DAILY_TOKEN_BUDGET=1000000
HERMES_RATE_LIMIT_PER_IP=30

# ── Mercury ──
INVITE_CODE=                 # 留空则开放注册
DISABLE_DOCS=true

# ── 可选的 Gemini（线索发现） ──
# GEMINI_API_KEY=
# LEAD_GEN_ENABLED=false
