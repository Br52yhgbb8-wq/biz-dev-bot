
# ── Hermes AI Security ──
# Comma-separated list of allowed domains for Hermes chat
# Add your production domain here before going live
HERMES_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3007,http://127.0.0.1:3000,http://127.0.0.1:3001
# Daily DeepSeek token budget (1M ≈ $0.14). -1 = unlimited, 0 = disabled
HERMES_DAILY_TOKEN_BUDGET=1000000
# Max requests per hour per IP
HERMES_RATE_LIMIT_PER_IP=30
